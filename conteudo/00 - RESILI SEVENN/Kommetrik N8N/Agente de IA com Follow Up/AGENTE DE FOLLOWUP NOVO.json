    {
      "parameters": {
        "jsCode": "// n8n — Code node (JS)\n// Entrada: itens com { id, session_id, message:{ type, content } }\n// Saída: [{ memoria: \"...\" }] (um por session_id)\n\nfunction normalizeText(v) {\n  if (v === null || v === undefined) return '';\n  if (typeof v === 'string') return v;\n  if (typeof v === 'number' || typeof v === 'boolean') return String(v);\n  try { return JSON.stringify(v); } catch { return String(v); }\n}\n\nfunction roleLabel(type) {\n  const t = String(type || '').toLowerCase();\n  if (t === 'ai' || t === 'assistant') return 'AGENTE';\n  if (t === 'human' || t === 'user') return 'CLIENTE';\n  return 'DESCONHECIDO';\n}\n\nconst items = $input.all();\n\n// Agrupa por session_id (se não existir, cai em \"default\")\nconst bySession = new Map();\nfor (const it of items) {\n  const j = it.json ?? {};\n  const sid = normalizeText(j.session_id) || 'default';\n  if (!bySession.has(sid)) bySession.set(sid, []);\n  bySession.get(sid).push(j);\n}\n\n// Ordena por id (ou mantém ordem original) e monta a memória\nconst out = [];\nfor (const [sid, arr] of bySession.entries()) {\n  arr.sort((a, b) => {\n    const ai = Number(a?.id); const bi = Number(b?.id);\n    if (Number.isFinite(ai) && Number.isFinite(bi)) return ai - bi;\n    return 0;\n  });\n\n  const linhas = [];\n  for (const row of arr) {\n    const msg = row?.message ?? {};\n    const label = roleLabel(msg.type);\n    const content = normalizeText(msg.content).trim();\n\n    // Se quiser incluir mensagens vazias, remova este if\n    if (!content) continue;\n\n    linhas.push(`# ${label}`);\n    linhas.push(`- ${content}`);\n  }\n\n  out.push({\n    json: {\n      memoria: linhas.join('\\n'),\n    },\n  });\n}\n\nreturn out;"
      },
