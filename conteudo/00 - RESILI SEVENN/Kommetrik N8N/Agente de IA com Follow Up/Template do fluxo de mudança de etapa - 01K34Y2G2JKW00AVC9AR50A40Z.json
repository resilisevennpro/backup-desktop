      "name": "buscaFunisEtapas",
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// n8n Code Node — confereFunilEtapa (Run Once for All Items)\n\ntry {\n  // === Nomes dos nós de entrada ===\n  const TRIGGER_NODE = 'When Executed by Another Workflow';\n  const PIPES_NODE   = 'buscaFunisEtapas';\n\n  // --- Helpers ---\n  const norm = (s) =>\n    String(s ?? '')\n      .normalize('NFD')               // remove acentos para comparação robusta\n      .replace(/\\p{Diacritic}/gu, '')\n      .toLowerCase()\n      .replace(/\\s+/g, ' ')\n      .trim();\n\n  const firstItem = (name) => {\n    const arr = $items(name);\n    if (!Array.isArray(arr) || !arr.length) {\n      throw new Error(`Sem itens no nó \"${name}\".`);\n    }\n    return arr[0]?.json ?? {};\n  };\n\n  // --- Lê entradas ---\n  const trigger = firstItem(TRIGGER_NODE);\n  const funilEtapaRaw = trigger['Funil-Etapa'];\n  if (!funilEtapaRaw || typeof funilEtapaRaw !== 'string') {\n    throw new Error('Campo \"Funil-Etapa\" ausente ou inválido no trigger.');\n  }\n\n  // separa antes/depois do primeiro hífen\n  const sepIdx = funilEtapaRaw.indexOf('-');\n  if (sepIdx < 0) {\n    throw new Error(\n      `Formato inválido em \"Funil-Etapa\": \"${funilEtapaRaw}\". Use \"Nome do Funil - Nome da Etapa\".`\n    );\n  }\n  const nomeFunil = funilEtapaRaw.slice(0, sepIdx).trim();\n  const nomeEtapa = funilEtapaRaw.slice(sepIdx + 1).trim();\n  if (!nomeFunil || !nomeEtapa) {\n    throw new Error(\n      `Formato inválido em \"Funil-Etapa\": \"${funilEtapaRaw}\". Faltou nome do funil ou da etapa.`\n    );\n  }\n\n  const pipelinesRoot = firstItem(PIPES_NODE);\n  const pipelines = pipelinesRoot?._embedded?.pipelines ?? [];\n  if (!pipelines.length) {\n    throw new Error('Nenhum funil retornado por \"buscaFunisEtapas\".');\n  }\n\n  // --- Busca funil ---\n  const alvoFunil = pipelines.find((p) => norm(p.name) === norm(nomeFunil));\n  if (!alvoFunil) {\n    throw new Error(`Funil \"${nomeFunil}\" não encontrado.`);\n  }\n\n  // --- Busca etapa dentro do funil encontrado ---\n  const statuses = alvoFunil?._embedded?.statuses ?? [];\n  const alvoEtapa = statuses.find((s) => norm(s.name) === norm(nomeEtapa));\n  if (!alvoEtapa) {\n    throw new Error(\n      `Etapa \"${nomeEtapa}\" não encontrada dentro do funil \"${alvoFunil.name}\".`\n    );\n  }\n\n  // --- Saída ---\n  return [\n    {\n      json: {\n        pipeline_name: alvoFunil.name,\n        pipeline_id: alvoFunil.id,\n        status_name: alvoEtapa.name,\n        status_id: alvoEtapa.id,\n      },\n    },\n  ];\n} catch (err) {\n  // Deixe o erro explícito para depuração do fluxo\n  throw new Error(`confereFunilEtapa: ${err.message}`);\n}"
      },
