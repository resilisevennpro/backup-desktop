    {
      "parameters": {
        "jsCode": "// Captura o array de entrada\nconst input = $input.item.json;\n\n// Função para converter UTC para UTC-3\nfunction convertToUTCMinus3(dateString) {\n  const date = new Date(dateString);\n  // Subtrai 3 horas (3 * 60 * 60 * 1000 ms)\n  date.setHours(date.getHours() - 3);\n  return date.toISOString(); // ou use .toLocaleString() se quiser formatado\n}\n\n// Clona os dados para evitar modificar o original diretamente\nconst updatedData = JSON.parse(JSON.stringify(input));\n\n// Itera sobre os bookings\nif (updatedData.data && Array.isArray(updatedData.data.bookings)) {\n  updatedData.data.bookings = updatedData.data.bookings.map(booking => {\n    booking.startTime = convertToUTCMinus3(booking.startTime);\n    booking.endTime = convertToUTCMinus3(booking.endTime);\n    return booking;\n  });\n}\n\nreturn [{ json: updatedData }];\n"
      },
