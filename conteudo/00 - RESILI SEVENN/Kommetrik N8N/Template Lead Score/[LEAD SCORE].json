    {
      "parameters": {
        "jsCode": "// n8n Function node\n// Entrada esperada em item.json com as chaves exatamente como no seu Set:\n// \"Nome do Lead\", \"Buscando Solução de IA\", \"Volume de Leads Diários\",\n// \"Principal Dificuldade no Atendimento\", \"Está disposto a investir acima de 5000\"\n\nfunction isYes(v) {\n  if (v === undefined || v === null) return false;\n  if (typeof v === 'boolean') return v;\n  const s = String(v).trim().toLowerCase();\n  return ['sim','yes','y','true','1'].includes(s);\n}\n\nfunction hasText(v) {\n  return String(v ?? '').trim().length > 0;\n}\n\nfunction toInt(v) {\n  // extrai dígitos de strings como \"23\", \"23 leads\", \"40+\" etc.\n  const m = String(v ?? '').match(/\\d+/g);\n  if (!m) return NaN;\n  const n = parseInt(m.join(''), 10);\n  return Number.isNaN(n) ? NaN : n;\n}\n\nreturn items.map(item => {\n  const d = item.json;\n\n  let score = 0;\n\n  // Nome -> 5\n  if (hasText(d['Nome do Lead'])) score += 5;\n\n  // Buscando solução de IA -> 5\n  if (isYes(d['Buscando Solução de IA'])) score += 5;\n\n  // Volume de leads diários -> <20:1 | 20-40:4 | >40:10\n  const vol = toInt(d['Volume de Leads Diários']);\n  if (!Number.isNaN(vol)) {\n    score += vol < 20 ? 1 : (vol <= 40 ? 4 : 10);\n  }\n\n  // Principal dificuldade no atendimento -> 5\n  if (hasText(d['Principal Dificuldade no Atendimento'])) score += 5;\n\n  // Está disposto a investir acima de 5000 -> 15\n  if (isYes(d['Está disposto a investir acima de 5000'])) score += 15;\n\n  // Temperatura\n  let temperatura = 'Frio';\n  if (score >= 35) temperatura = 'Quente';\n  else if (score > 20) temperatura = 'Morno'; // 21–34\n\n  // anexa ao item\n  item.json.lead_score = score;\n  item.json.lead_score_max = 40;\n  item.json.lead_temperatura = temperatura;\n\n  // (opcional) devolve também um resumo\n  item.json.lead_resumo = `Score: ${score}/40 | Temperatura: ${temperatura}`;\n\n  return item;\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
