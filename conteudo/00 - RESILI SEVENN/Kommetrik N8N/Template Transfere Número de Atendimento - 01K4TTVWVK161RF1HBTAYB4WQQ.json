    {
      "parameters": {
        "jsCode": "// Code node (Run Once for All Items)\n// Busca histórico a partir do nó especificado\nconst historicoItems = $items(\"puxaHistorico\"); // substitua pelo nome real do nó anterior\n\n// Definições de nomes\nconst NOME_CLIENTE = \"Cliente\";\nconst NOME_AGENTE  = \"Carlos\";\n\nlet historico = \"# HISTÓRICO DE CONVERSA\\n\";\n\nfor (const item of historicoItems) {\n  const msg = item.json.message;\n  if (!msg?.content) continue;\n\n  if (msg.type === \"human\") {\n    historico += `## ${NOME_CLIENTE}: ${msg.content}\\n`;\n  } else if (msg.type === \"ai\") {\n    historico += `## ${NOME_AGENTE}: ${msg.content}\\n`;\n  }\n}\n\nreturn [\n  {\n    json: {\n      historico_markdown: historico.trim()\n    }\n  }\n];"
      },
