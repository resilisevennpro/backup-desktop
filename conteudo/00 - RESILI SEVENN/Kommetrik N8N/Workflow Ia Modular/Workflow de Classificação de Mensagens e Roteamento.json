      "parameters": {
        "jsCode": "const inputs = $input.all();\n\nlet prompt = '';\nlet mensagem = '';\n\nfor (const item of inputs) {\n  if (item.json.prompt_content) prompt = item.json.prompt_content;\n  if (item.json.listaMensagens) mensagem = item.json.listaMensagens;\n}\n\nreturn [\n  {\n    json: {\n      prompt_content: prompt,\n      listaMensagens: mensagem\n    }\n  }\n];\n"
