    },
    {
      "parameters": {
        "jsCode": "// tenta pegar do BUSCA LEAD, depois do (RETENTATIVA), depois do próprio input\nconst get = (name) => {\n  try {\n    const it = $(name).first();\n    return it?.json ?? null;\n  } catch (e) { return null; }\n};\n\nconst lead =\n  get('BUSCA LEAD') ??\n  get('BUSCA LEAD (RETENTATIVA)') ??\n  $json?.['busca lead'] ??        // pelo seu print, o input chega assim\n  $json ??                        // último recurso\n  null;\n\nreturn { data: lead };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -5472,
        544
      ],
      "id": "e9c288d9-18c4-4d95-9085-5338fe9b8e57",
      "name": "DADOS DO LEAD"
    },
    {
      "parameters": {
