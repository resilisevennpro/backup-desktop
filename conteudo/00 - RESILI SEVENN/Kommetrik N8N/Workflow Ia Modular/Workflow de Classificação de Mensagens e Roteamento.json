    {
      "parameters": {
        "jsCode": "/***** CONFIGURAÇÃO *****/\nconst TAGS_DE_INTERESSE = [\n  '1',\n  'ATENDIMENTO',\n  '3',\n  // adicione aqui novas tags, sempre em MAIÚSCULO\n];\n\n/***** PEGA O LEAD *****/\n// Busca SEMPRE o primeiro item que saiu do node \"DADOS DO LEAD\"\nconst lead = $items('DADOS DO LEAD')[0].json;\n\n/***** EXTRAI AS TAGS *****/\nconst tags =\n  lead._embedded?.tags ??\n  lead.data?._embedded?.tags ??  // se vier embrulhado em \"data\"\n  [];\n\nconst normaliza = (t) => (t?.name ?? '').trim().toUpperCase();\nconst tagNames = tags.map(normaliza);\n\n/***** CRIA AS FLAGS DINÂMICAS *****/\nconst saida = {\n  ...$json,   // mantém os campos originais do item corrente\n  tagNames,   // array com todos os nomes normalizados\n};\n\n// Gera automaticamente uma flag booleana pra cada tag de interesse\nTAGS_DE_INTERESSE.forEach((tag) => {\n  const chave = `has${tag}`;              // ex.: \"hasBPC\"\n  saida[chave] = tagNames.includes(tag);  // true / false\n});\n\n// Exemplos extras de info que você pode querer\nsaida.tagPrincipal = TAGS_DE_INTERESSE.find((t) => tagNames.includes(t)) ?? null;\nsaida.quantidadeTags = tagNames.length;\n\n/***** DEVOLVE *****/\nreturn saida;\n"
      },
